{
    "name": "divino11/laravel-playtomic",
    "description": "Laravel SDK for the Playtomic API — venue search, court availability, booking, and authentication.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "playtomic",
        "padel",
        "booking",
        "api"
    ],
    "authors": [
        {
            "name": "Divino11",
            "email": "divino11@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Divino11\\Playtomic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Divino11\\Playtomic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Divino11\\Playtomic\\PlaytomicServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}